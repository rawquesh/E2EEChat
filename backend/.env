# =============================================================================
# Backend Configuration — Replace all PLACEHOLDER values with real credentials
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB
# Local: mongodb://localhost:27017/e2ee_chat
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/e2ee_chat
MONGODB_URI=mongodb://localhost:27017/e2ee_chat

# JWT — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_YOUR_JWT_SECRET

# CORS — comma-separated list of allowed origins
# For local dev: http://localhost:PORT_USED_BY_FLUTTER
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://YOUR_FLUTTER_IP:PORT

# =============================================================================
# Soketi (self-hosted WebSocket server — Pusher-compatible)
# Generate any random string for these values. The Flutter app's pusherKey
# must match SOKETI_APP_KEY exactly.
# =============================================================================
SOKETI_HOST=localhost        # Internal: Soketi service hostname (same host in Docker)
SOKETI_PORT=6001
SOKETI_APP_ID=app-id         # Matches Flutter's pusherKey config (app ID)
SOKETI_APP_KEY=app-key       # Flutter app uses this as pusherKey
SOKETI_APP_SECRET=app-secret # Server-side auth only

# =============================================================================
# TURN/STUN Server (for WebRTC)
# STUN works immediately — no credentials needed (Google STUN server).
# TURN is optional — add only if WebRTC calls fail in production:
#   Option A: Metered.ca free TURN — https://www.metered.ca/tools/openrelay/
#   Option B: Self-hosted Coturn on a separate VPS
# =============================================================================
STUN_HOST=stun.l.google.com
STUN_PORT=19302
TURN_HOST=REPLACE_WITH_TURN_HOST
TURN_PORT=3478
TURNS_PORT=5349
TURN_USERNAME=REPLACE_WITH_TURN_USER
TURN_CREDENTIAL=REPLACE_WITH_TURN_PASS

# =============================================================================
# File Upload
# Maximum file size for profile photos (in bytes)
# =============================================================================
MAX_FILE_SIZE=10485760
