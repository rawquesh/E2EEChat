# =============================================================================
# Backend Configuration — copy to backend/.env and replace all PLACEHOLDERs
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB — your database connection string
# Local:        mongodb://localhost:27017/e2ee_chat
# Atlas (free): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/e2ee_chat
MONGODB_URI=YOUR_MONGODB_URI

# JWT — used to sign auth tokens.
# generate: openssl rand -hex 32
JWT_SECRET=YOUR_JWT_SECRET

# CORS — comma-separated list of origins allowed to call this API.
# For local dev, add the Flutter app's origin (http://localhost:PORT or http://<device-ip>:PORT).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Soketi (self-hosted WebSocket server — Pusher-compatible)
# Any random strings work; they just must be consistent between backend and app.
# The Flutter app's pusherKey MUST match SOKETI_APP_KEY exactly.
# generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# =============================================================================
SOKETI_HOST=localhost        # Internal: Soketi service hostname (same host in Docker)
SOKETI_PORT=6001
SOKETI_APP_ID=YOUR_SOKETI_APP_ID      # e.g. app-id
SOKETI_APP_KEY=YOUR_SOKETI_APP_KEY    # Flutter app uses this as pusherKey
SOKETI_APP_SECRET=YOUR_SOKETI_APP_SECRET # Server-side auth only

# =============================================================================
# TURN/STUN Server (for WebRTC) — OPTIONAL
# STUN works out of the box (Google STUN, no credentials).
# Add a TURN server only if WebRTC calls fail behind restrictive NATs:
#   Option A: metered.ca free TURN  — https://www.metered.ca/tools/openrelay/
#   Option B: self-hosted coturn on a separate VPS
# =============================================================================
STUN_HOST=stun.l.google.com
STUN_PORT=19302
TURN_HOST=YOUR_TURN_HOST_OR_LEAVE_EMPTY
TURN_PORT=3478
TURNS_PORT=5349
TURN_USERNAME=YOUR_TURN_USERNAME_OR_LEAVE_EMPTY
TURN_CREDENTIAL=YOUR_TURN_PASSWORD_OR_LEAVE_EMPTY

# =============================================================================
# File Upload
# Maximum file size for profile photos (in bytes) — default 10 MB
# =============================================================================
MAX_FILE_SIZE=10485760
